<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI Design Editor"
            android:textColor="@color/light_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:padding="16dp" />

        <EditText
            android:id="@+id/edit_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Describe your UI design..."
            android:inputType="textMultiLine"
            android:minLines="5"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:textColor="@color/light_text" />

        <EditText
            android:id="@+id/edit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Preview content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:background="@drawable/edit_text_background"
            android:padding="12dp"
            android:textColor="@color/light_text" />

        <Button
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Generate Design"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save Design"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Preview Design"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <Button
            android:id="@+id/fab_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/ic_dashboard"
            android:contentDescription="Back" />

    </LinearLayout>
</ScrollView>